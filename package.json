{
  "name": "videoops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-http-header-size=32768' next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "auditar:tenancy": "node scripts/auditar-tenancy.mjs",
    "auditar:perfil-global": "node scripts/auditar-perfil-global.mjs",
    "db:migrate": "node scripts/guarda-banco.mjs && prisma migrate dev",
    "db:deploy": "node scripts/guarda-banco.mjs && prisma migrate deploy",
    "db:status": "prisma migrate status",
    "_comment_db_push": "db:push NÃO versiona schema — use só em protótipo local. Mudança que vai para produção entra por db:migrate.",
    "db:push": "node scripts/guarda-banco.mjs && prisma db push",
    "db:seed": "node scripts/guarda-banco.mjs && dotenv -e .env.local -- ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:studio": "prisma studio",
  "migrar:editor-designer": "node scripts/guarda-banco.mjs && dotenv -e .env.local -- ts-node --compiler-options '{\"module\":\"CommonJS\"}' -r tsconfig-paths/register prisma/migrar-editor-designer.ts",
  "sanear:perfil-global": "node scripts/guarda-banco.mjs && dotenv -e .env.local -- ts-node --compiler-options '{\"module\":\"CommonJS\"}' -r tsconfig-paths/register prisma/sanear-perfil-global.ts",
  "faxina:alertas": "node scripts/guarda-banco.mjs && dotenv -e .env.local -- ts-node --compiler-options '{\"module\":\"CommonJS\"}' -r tsconfig-paths/register prisma/faxina-alertas.ts",
    "_comment_guarda_banco": "Comandos que escrevem no banco passam por scripts/guarda-banco.mjs. Produção exige PERMITIR_BANCO_PRODUCAO=sim — ver o cabeçalho do script."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@base-ui/react": "^1.2.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@supabase/supabase-js": "^2.99.1",
    "@types/archiver": "^7.0.0",
    "@types/pg": "^8.18.0",
    "@vladmandic/face-api": "^1.7.15",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.577.0",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.30",
    "openai": "^6.29.0",
    "pg": "^8.20.0",
    "prisma": "^7.5.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "resend": "^6.9.3",
    "shadcn": "^4.0.5",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
