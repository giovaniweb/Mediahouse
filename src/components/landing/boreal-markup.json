nter;backdrop-filter:blur(24px)}#nss .nb-price{font-size:clamp(65px,11cqw,100px);font-weight:700;letter-spacing:-5px;margin:20px 0;line-height:1}#nss .nb-price sup{font-size:22px;font-weight:400;letter-spacing:0}#nss .nb-price small{font-size:16px;font-weight:300;letter-spacing:0}#nss .nb-offer p{color:#c1b9d1;font-size:14px;line-height:1.7}#nss .nb-offer ul{list-style:none;padding:20px 0;border-top:1px solid #ffffff20;border-bottom:1px solid #ffffff20;display:flex;gap:20px;justify-content:center;flex-wrap:wrap;font-size:12px;color:#ded5ed}#nss .ns-faq p{color:#b7acc9}#nss details{border-color:#ffffff20}#nss .nb-toggle{display:inline-flex;align-items:center;gap:8px;letter-spacing:0;text-transform:none}#nss .nb-toggle:before{content:'';width:23px;height:13px;background:#8b64c8;border-radius:12px;box-shadow:inset -10px 0 #e8dcff}#nss .nb-confetti{position:absolute;width:7px;height:10px;top:50%;left:50%;pointer-events:none;z-index:10}#nss[data-still=true] .nb-job{transition:none}#nss .ns-chapterbar button{font-size:10px}#nss .ns-scene-caption{color:#a69aba}#nss .ns-sect button[style],#nss .ns-founder button[style]{color:#d9cbed!important;border-color:#806b9d!important}@container(max-width:650px){#nss .nb-board{height:225px;grid-template-columns:repeat(3,minmax(0,1fr))}#nss .nb-col:nth-child(n+4){margin-top:8px}#nss .nb-ghost{display:none}#nss .nb-col{min-height:100px}#nss .nb-job{width:calc((100% - 14px)/3);left:calc(var(--mobile-stage)*((100% + 7px)/3));top:calc(34px + var(--mobile-row)*114px);min-height:74px!important;padding:7px}#nss .nb-job strong{font-size:10px;margin:4px 0}#nss .nb-job em{font-size:8px}#nss .nb-job small{display:none}#nss .nb-toast{padding:10px;margin-top:9px;font-size:10px}#nss .nb-toast small{display:none}#nss .nb-jobs{grid-template-columns:1fr}#nss .nb-offer{padding:25px}#nss .nb-calendar{padding:18px}#nss .ns-story-title p{font-size:10px}#nss .ns-story-title{gap:8px;margin-bottom:10px}#nss .ns-progress{margin:8px 0 10px}#nss .ns-scene{padding