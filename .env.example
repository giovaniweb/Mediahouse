DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Área de cada empresa no próprio endereço: <slug>.nuflow.space (ver src/lib/subdominio.ts).
# Raiz padrão: nuflow.space. No teste local, "nuflow.localhost" (área em
# contourline.nuflow.localhost:<porta>); "localhost" puro entra em laço no login.
# NEXT_PUBLIC_DOMINIO_RAIZ="nuflow.space"
# "1" liga o 301 de /c/<slug> para o subdomínio e o link novo em Configurações.
# Só depois que *.nuflow.space estiver respondendo. Mudar pede novo deploy.
# NEXT_PUBLIC_AREA_POR_SUBDOMINIO="1"

# Caixa de Entrada Microsoft 365
# Redirect URI no Azure: http://localhost:3000/api/email-inbox/callback
MICROSOFT_CLIENT_ID="azure-app-client-id"
MICROSOFT_CLIENT_SECRET="azure-app-client-secret"
MICROSOFT_TENANT_ID="common"
EMAIL_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"
CRON_SECRET="generate-with-openssl-rand-base64-32"
